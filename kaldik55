        // ==================== HELPERS ====================
        function getEventsForDate(dateStr) {
            return events.filter(e => e.date === dateStr);
        }

        function getCategoryClass(category) {
            const map = {
                'libur': 'red',
                'masuk': 'blue',
                'ujian': 'yellow',
                'tka': 'cyan',
                'libur_sem': 'grey',
                'rapor': 'lime'
            };
            return map[category] || 'blue';
        }

        function getCategoryLabel(category) {
            const map = {
                'libur': 'Libur Nasional',
                'masuk': 'Masuk / MPLS',
                'ujian': 'Asesmen / Ujian',
                'tka': 'TKA / Cuti',
                'libur_sem': 'Libur Semester',
                'rapor': 'Penyerahan Rapor'
            };
            return map[category] || category;
        }

        function getCategoryColor(category) {
            const map = {
                'libur': 'bg-red-100 text-red-800 border-red-400',
                'masuk': 'bg-blue-100 text-blue-800 border-blue-400',
                'ujian': 'bg-yellow-100 text-yellow-800 border-yellow-400',
                'tka': 'bg-cyan-100 text-cyan-800 border-cyan-400',
                'libur_sem': 'bg-gray-100 text-gray-800 border-gray-400',
                'rapor': 'bg-lime-100 text-lime-800 border-lime-400'
            };
            return map[category] || 'bg-gray-100 text-gray-800';
        }

        // ==================== RENDER CALENDAR ====================
        function renderMonth(month, year, containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;

            const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
                'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
            ];

            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const daysInPrevMonth = new Date(year, month, 0).getDate();

            const monthCard = document.createElement('div');
            monthCard.className = 'month-card';

            // Header
            const header = document.createElement('div');
            header.className = 'month-header';
            header.innerHTML = `
                <span class="month-name">${monthNames[month]}</span>
                <span class="month-year">${year}</span>
            `;
            monthCard.appendChild(header);

            // Grid
            const grid = document.createElement('div');
            grid.className = 'calendar-grid';

            // Day headers
            const dayNames = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
            dayNames.forEach(name => {
                const div = document.createElement('div');
                div.className = 'day-header';
                div.textContent = name;
                grid.appendChild(div);
            });

            // Empty cells for first week
            for (let i = 0; i < firstDay; i++) {
                const empty = document.createElement('div');
                empty.className = 'day-cell other-month';
                const prevDate = daysInPrevMonth - firstDay + i + 1;
                empty.innerHTML = `<span class="date-number">${prevDate}</span>`;
                grid.appendChild(empty);
            }

            // Days of the month
            const today = new Date();
            const todayStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;

            for (let d = 1; d <= daysInMonth; d++) {
                const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
                const dayEvents = getEventsForDate(dateStr);

                const cell = document.createElement('div');
                cell.className = 'day-cell';

                // Check if today
                if (dateStr === todayStr) {
                    cell.classList.add('today');
                }

                // Check if Sunday
                const dayOfWeek = new Date(year, month, d).getDay();
                if (dayOfWeek === 0) {
                    cell.classList.add('sunday');
                }

                // Date number
                const numSpan = document.createElement('div');
                numSpan.className = 'date-number';
                numSpan.textContent = d;
                cell.appendChild(numSpan);

                // Events
                if (dayEvents.length > 0) {
                    dayEvents.forEach(ev => {
                        const label = document.createElement('div');
                        const catClass = getCategoryClass(ev.category);
                        label.className = `event-label ${catClass}`;
                        label.textContent = ev.title;
                        label.title = ev.title;
                        label.onclick = (e) => {
                            e.stopPropagation();
                            showModal(dateStr, ev.title, ev.category);
                        };
                        cell.appendChild(label);
                    });
                }

                grid.appendChild(cell);
            }

            // Fill remaining cells
            const totalCells = firstDay + daysInMonth;
            const remaining = (7 - (totalCells % 7)) % 7;
            for (let i = 1; i <= remaining; i++) {
                const empty = document.createElement('div');
                empty.className = 'day-cell other-month';
                empty.innerHTML = `<span class="date-number">${i}</span>`;
                grid.appendChild(empty);
            }

            monthCard.appendChild(grid);
            container.appendChild(monthCard);
        }

        // ==================== RENDER ALL ====================
        function renderAll() {
            // Semester 1: Juli - Desember 2026
            const sem1Grid = document.getElementById('sem1Grid');
            sem1Grid.innerHTML = '';
            for (let m = 6; m <= 11; m++) {
                renderMonth(m, 2026, 'sem1Grid');
            }

            // Semester 2: Januari - Juni 2027
            const sem2Grid = document.getElementById('sem2Grid');
            sem2Grid.innerHTML = '';
            for (let m = 0; m <= 5; m++) {
                renderMonth(m, 2027, 'sem2Grid');
            }
        }

        // ==================== VIEW SWITCHER ====================
        let currentView = 'all';

        function switchView(view) {
            currentView = view;
            const sem1 = document.getElementById('sectionSem1');
            const sem2 = document.getElementById('sectionSem2');
            const btn1 = document.getElementById('btn-sem1');
            const btn2 = document.getElementById('btn-sem2');
            const btnAll = document.getElementById('btn-all');
            const title = document.getElementById('viewTitle');

            const activeClass = 'px-3 py-1.5 rounded-md font-bold transition-all bg-accent text-[#1a237e] shadow';
            const inactiveClass = 'px-3 py-1.5 rounded-md font-bold text-gray-300 hover:text-white transition-all';

            [btn1, btn2, btnAll].forEach(b => b.className = inactiveClass);

            if (view === 'sem1') {
                sem1.classList.remove('hidden');
                sem2.classList.add('hidden');
                btn1.className = activeClass;
                title.textContent = 'KALENDER PENDIDIKAN TA 2026/2027 - SEMESTER 1';
            } else if (view === 'sem2') {
                sem1.classList.add('hidden');
                sem2.classList.remove('hidden');
                btn2.className = activeClass;
                title.textContent = 'KALENDER PENDIDIKAN TA 2026/2027 - SEMESTER 2';
            } else {
                sem1.classList.remove('hidden');
                sem2.classList.remove('hidden');
                btnAll.className = activeClass;
                title.textContent = 'KALENDER PENDIDIKAN TA 2026/2027 (FULL YEAR)';
            }
        }

        // ==================== MODAL ====================
        function showModal(date, title, category) {
            const modal = document.getElementById('eventModal');
            document.getElementById('modalDate').textContent = date;
            document.getElementById('modalDesc').textContent = title;

            const badge = document.getElementById('modalBadge');
            badge.textContent = getCategoryLabel(category);
            badge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold ${getCategoryColor(category)}`;

            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('eventModal').classList.add('hidden');
        }

        // Close modal on outside click
        document.getElementById('eventModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        // Close modal with ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeModal();
        });

        // ==================== SEARCH ====================
        function handleSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const panel = document.getElementById('searchResults');
            const list = document.getElementById('searchList');

            if (query.length < 2) {
                panel.classList.add('hidden');
                return;
            }

            const results = events.filter(e =>
                e.title.toLowerCase().includes(query) ||
                e.date.includes(query) ||
                e.category.includes(query)
            );

            if (results.length > 0) {
                panel.classList.remove('hidden');
                list.innerHTML = results.map(r => `
                    <li class="bg-white p-2 rounded border border-yellow-200 flex justify-between items-center cursor-pointer hover:bg-yellow-50"
                        onclick="showModal('${r.date}', '${r.title}', '${r.category}')">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-gray-900 text-xs">${r.date}</span>
                            <span class="text-gray-800 text-sm">${r.title}</span>
                        </div>
                        <span class="text-[10px] ${getCategoryColor(r.category)} px-2 py-0.5 rounded font-bold">
                            ${getCategoryLabel(r.category)}
                        </span>
                    </li>
                `).join('');
            } else {
                panel.classList.remove('hidden');
                list.innerHTML = `<li class="text-red-600 italic text-sm p-2">Tidak ditemukan kegiatan dengan kata kunci "${query}"</li>`;
            }
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchResults').classList.add('hidden');
        }

        // ==================== DARK MODE ====================
        let darkMode = false;

        function toggleDarkMode() {
            darkMode = !darkMode;
            const body = document.body;

            if (darkMode) {
                body.classList.add('dark');
                body.style.background = '#111827';
                body.style.color = '#e5e7eb';
                document.querySelectorAll('.bg-white').forEach(el => {
                    if (!el.closest('header') && !el.closest('footer')) {
                        el.style.background = '#1f2937';
                        el.style.color = '#e5e7eb';
                    }
                });
                document.querySelectorAll('.bg-gray-50').forEach(el => {
                    el.style.background = '#374151';
                });
                document.querySelectorAll('.text-gray-900').forEach(el => {
                    if (!el.closest('header')) el.style.color = '#e5e7eb';
                });
                document.querySelectorAll('.text-gray-500, .text-gray-600').forEach(el => {
                    el.style.color = '#9ca3af';
                });
                document.querySelectorAll('.border-gray-200').forEach(el => {
                    el.style.borderColor = '#374151';
                });
                // Month cards
                document.querySelectorAll('.month-card').forEach(el => {
                    el.style.background = '#1f2937';
                });
                document.querySelectorAll('.calendar-grid .day-cell').forEach(el => {
                    el.style.background = '#1f2937';
                    el.style.color = '#e5e7eb';
                });
                document.querySelectorAll('.calendar-grid .day-cell.other-month').forEach(el => {
                    el.style.color = '#6b7280';
                    el.style.background = '#111827';
                });
                document.querySelectorAll('.calendar-grid .day-cell.today').forEach(el => {
                    el.style.background = '#1e3a5f';
                });
                document.querySelector('.fa-moon').className = 'fa-solid fa-sun';
            } else {
                body.classList.remove('dark');
                body.style.background = '#f0f2f5';
                body.style.color = '';
                document.querySelectorAll('.bg-white').forEach(el => {
                    if (!el.closest('header') && !el.closest('footer')) {
                        el.style.background = '';
                        el.style.color = '';
                    }
                });
                document.querySelectorAll('.bg-gray-50').forEach(el => {
                    el.style.background = '';
                });
                document.querySelectorAll('.text-gray-900').forEach(el => {
                    if (!el.closest('header')) el.style.color = '';
                });
                document.querySelectorAll('.text-gray-500, .text-gray-600').forEach(el => {
                    el.style.color = '';
                });
                document.querySelectorAll('.border-gray-200').forEach(el => {
                    el.style.borderColor = '';
                });
                document.querySelectorAll('.month-card').forEach(el => {
                    el.style.background = '';
                });
                document.querySelectorAll('.calendar-grid .day-cell').forEach(el => {
                    el.style.background = '';
                    el.style.color = '';
                });
                document.querySelectorAll('.calendar-grid .day-cell.other-month').forEach(el => {
                    el.style.color = '';
                    el.style.background = '';
                });
                document.querySelectorAll('.calendar-grid .day-cell.today').forEach(el => {
                    el.style.background = '';
                });
                document.querySelector('.fa-sun').className = 'fa-solid fa-moon';
            }
        }

